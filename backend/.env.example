# Copy to .env and adjust. Values below are safe defaults for local demo.

# API_KEY=change-me-in-production
# CARD_SIGNING_SECRET=change-me-in-production

# DATABASE_URL=sqlite:///./scanner.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/scanner

# FACE_MATCH_THRESHOLD=0.363
# PENDING_SCAN_TTL_MINUTES=30
# MATCHED_SCAN_RETENTION_DAYS=30

# CARD_ORGANIZATION=JizPi IT PARK
# CARD_PREFIX=UZN
# STUDENT_CODE_PREFIX=SA

# Comma-separated browser origins. Leave empty for mobile-only (recommended).
# CORS_ORIGINS=http://localhost:3000

# SCAN_RATE_LIMIT_PER_MINUTE=60
# DOCS_ENABLED=1
